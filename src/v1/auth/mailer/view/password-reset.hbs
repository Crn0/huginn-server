<html>

<head>
  <meta charset="utf-8" />

  <style>
    header {
      display: flex;
    }

    header>img {
      height: 2rem;
      width: 2rem;
    }

    main>p {
      text-align: left;
    }
  </style>
</head>

<body>

  <div>
    <img src="cid:huginnLogo" alt="logo" />
  </div>

  <main>
    <h1>Reset your password?</h1>

    <p>If you requested a password reset for @{{username}},</p>

    <p>click the link below to complete the process. If you didn't make this request, ignore this
      email.</p>

    <a href={{redirectTo}} target="_blank" rel="noopener">{{redirectTo}}</a>

  </main>
</body>

</html>