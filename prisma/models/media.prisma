model Media {
  primaryKey Int       @id @default(autoincrement()) @map("primary_key")
  id         String    @unique @default(uuid(7)) @db.Uuid
  type       MediaType
  filePath   String    @map("file_path") @db.VarChar()
  bytes      Int
  url        String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  userProfileAvatarPk Int?         @unique @map("user_profile_avatar_pk")
  userProfileAvatar   UserProfile? @relation(name: "UserProfileAvatar", map: "Media_user_profile_avatar_pk_fkey", fields: [userProfileAvatarPk], references: [primaryKey], onDelete: Cascade)
  userProfileBannerPk Int?         @unique @map("user_profile_banner_pk")
  userProfileBanner   UserProfile? @relation(name: "UserProfileBanner", map: "Media_user_profile_banner_pk_fkey", fields: [userProfileAvatarPk], references: [primaryKey], onDelete: Cascade)

  @@map("Medias")
}

enum MediaType {
  IMAGE @map("image")
  GIF   @map("gif")
  VIDEO @map("video")
}
